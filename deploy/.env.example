# trakt-api environment template — copy to .env and fill real values.
# .env is gitignored; NEVER commit real secrets.

# Server
APP_ENV=development
PORT=8080

# Data layer (T0.4+)
DATABASE_URL=postgres://trakt:***@localhost:55432/trakt?sslmode=disable
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME_MINUTES=30
DB_SLOW_QUERY_THRESHOLD_MS=10
REDIS_URL=redis://localhost:56379

# TMDB v4 read-access token (server-side only; never expose to browsers)
TMDB_API_TOKEN=<tmdb-v4-read-token>

# Clerk (Phase 2; dev defaults point at clerk-emulator)
CLERK_API_BASE_URL=http://localhost:4000
CLERK_SECRET_KEY=<clerk-secret>

# Admin/mod user whitelists (Clerk user IDs, comma-separated)
ADMIN_USER_IDS=
MOD_USER_IDS=

# S3/MinIO (avatars, list covers, imports — T1+)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=trakt
S3_SECRET_KEY=<minio-secret>
