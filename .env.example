# Environment for the omnibus install (docker-compose.yml) and for the
# multi-container layout (docker-compose.advanced.yml).
#
#   cp .env.example .env
#   # set HAAKU_SECRET_KEY and TMDB_API_TOKEN below, then:
#   docker compose up -d
#
# .env is gitignored; NEVER commit real values. deploy/.env.example is the
# longer list for running the API from source on the host.

# --- Required -----------------------------------------------------------------

# Root key for everything stored encrypted at rest. The server refuses to start
# without it, and it must be at least 32 characters. Generate one:
#   openssl rand -base64 48
# Back it up SEPARATELY from the config directory: a database dump full of
# ciphertext that travels with the key gives no confidentiality, and losing the
# key makes the encrypted secrets unrecoverable.
HAAKU_SECRET_KEY=

# TMDB v4 API read access token (https://www.themoviedb.org/settings/api).
# Server-side only; never expose it to browsers.
TMDB_API_TOKEN=

# --- Owner account (local mode) ----------------------------------------------
#
# The owner account is created from these two values on the first start of an
# empty instance, before the API answers anything. It is the admin account you
# log in with; there is no "whoever signs up first becomes the owner" any more.
#
# Both are REQUIRED on the first start of a local-mode instance: with the
# database empty and these unset, the server refuses to start (rather than come
# up with nobody able to administer it). After the owner exists they are not
# consulted again, and a second start never modifies the account — so you can
# leave them set or blank them out once you are signed in.
#
# The password must be at least 10 characters. It is hashed with Argon2id and
# never logged.
#
# These are ignored entirely in clerk mode (HAAKU_AUTH_MODE=clerk).
HAAKU_ADMIN_EMAIL=
HAAKU_ADMIN_PASSWORD=

# --- Usually left alone -------------------------------------------------------

# Host port for the web UI. The container always listens on 8080.
HAAKU_PORT=8080

# Host directory holding the database, the Redis append-only file, the app's
# own directory and the pre-migration backups. Back this up.
HAAKU_CONFIG=./config

# The exact image to run. Pin a digest for a reproducible install:
#   HAAKU_IMAGE=ghcr.io/haaku-tv/haaku@sha256:<digest>
# HAAKU_IMAGE=ghcr.io/haaku-tv/haaku:latest

# The account the app runs as inside the container. Set these when the config
# directory is a bind mount owned by a host user, so the app can write to it.
# PUID=911
# PGID=911

# TZ=UTC

# --- PostgreSQL and Redis -----------------------------------------------------
#
# Leave both unset and the omnibus image runs its own PostgreSQL and Redis. Set
# one and the matching bundled service stays off — that is what
# docker-compose.advanced.yml does, naming the containers next to the app.

# DATABASE_URL=postgres://haaku:haaku@postgres:5432/haaku?sslmode=disable
# REDIS_URL=redis://redis:6379

# Password for the postgres service in docker-compose.advanced.yml.
# POSTGRES_PASSWORD=haaku

# --- Background workers -------------------------------------------------------
#
# The app runs its background workers (webhook delivery, activity fan-out, the
# event outbox, the TMDB maintenance jobs) inside the API process, so one
# container is still the whole install. Leave HAAKU_WORKER unset for that.
#
# To run the workers in a process of their own instead, set
# HAAKU_WORKER_SERVICE=true: the init then starts a second service in this
# container and turns the API's own workers off, so each worker runs in exactly
# one place. Optionally restrict that service to a subset:
# HAAKU_WORKER_SERVICE=true
# HAAKU_WORKER_SERVICE_SELECTION=webhooks,activity,outbox,metadata,stats
#
# The worker process answers /healthz and /readyz on its own address (the API
# answers on the app port, so a worker needs one that does not collide):
# HAAKU_WORKER_HEALTH_LISTEN=127.0.0.1:9090
#
# In the multi-container layout (docker-compose.advanced.yml) every service
# reads this file, so HAAKU_WORKER=none is what leaves the workers to the
# `worker` service, and HAAKU_WORKER_SELECTION picks that service's subset:
# HAAKU_WORKER=none
# HAAKU_WORKER_SELECTION=all
#
# TMDB maintenance (the metadata worker): where the change-feed cursor lives and
# how many popular pages one backfill pass walks.
# METADATA_SINCE_FILE=.hermes/metadata_sync_since.txt
# METADATA_BACKFILL_PAGES=5

# --- Optional tuning ----------------------------------------------------------
#
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME_MINUTES=30
# DB_SLOW_QUERY_THRESHOLD_MS=10
# CORS_ORIGINS=
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_WINDOW=60
# RATE_LIMIT_AUTH_MAX=100
# RATE_LIMIT_PUBLIC_WINDOW=60
# RATE_LIMIT_PUBLIC_MAX=30

# --- Identity (Clerk) ---------------------------------------------------------
#
# The API requires Clerk today, so a deployment needs a Clerk instance. See
# "Identity" in README.md — this is a known open decision for self-hosting.
# CLERK_API_BASE_URL=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
