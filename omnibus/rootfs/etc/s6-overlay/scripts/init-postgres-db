#!/command/with-contenv bash
# shellcheck shell=bash
# Create the trakt database. The haaku role created the cluster, so it is the
# superuser and can do this itself; the app's migrations own everything else.
set -euo pipefail
# shellcheck source=omnibus/rootfs/etc/haaku-omnibus/lib.sh
source /etc/haaku-omnibus/lib.sh

enabled postgres || exit 0
export HOME=/config/haaku

psql_haaku() {
  s6-setuidgid haaku psql -v ON_ERROR_STOP=1 -qAtX -h /run/postgresql -U haaku "$@"
}

if [[ "$(psql_haaku -d postgres -c "SELECT 1 FROM pg_database WHERE datname = 'trakt'")" != "1" ]]; then
  log "creating the trakt database"
  psql_haaku -d postgres -c 'CREATE DATABASE trakt'
fi

# Nothing signs in over TCP: peer authentication on the socket is the only way
# in, and the role has no password to lose.
psql_haaku -d postgres -c 'ALTER ROLE haaku PASSWORD NULL'

# The app applies its own migrations at startup (see docs/architecture/
# omnibus-image.md), so there is no schema work here. Keeping it that way is
# what lets the same binary run as a worker that cannot migrate.
